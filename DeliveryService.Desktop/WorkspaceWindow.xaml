<Window x:Class="DeliveryService.Desktop.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeliveryService.Desktop"
        Title="Служба доставки" Width="1280" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="WorkspaceWindow">
  <Window.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush"/>
    <local:StatusTextConverter x:Key="StatusText"/>
    <local:EmptyTextConverter x:Key="EmptyText"/>
    <local:BoolToVisibilityConverter x:Key="VisibleWhen"/>
    <Style TargetType="TabItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border Height="0" BorderThickness="0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock" x:Key="SectionTitle">
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Navy}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="MetricLabel">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource NavyDeep}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,26,0,26">
          <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource Amber}"
                  HorizontalAlignment="Left" Margin="22,0,0,14">
            <Path Data="M6,21 L17,10 L14,18 L24,18 L12,31 L15,22 Z" Fill="{StaticResource NavyDeep}"
                  Stretch="Uniform" Margin="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="СЛУЖБА ДОСТАВКИ" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="22,0,0,0"/>
          <TextBlock Text="Панель управления" Foreground="#8FA8BD" FontSize="12" Margin="22,3,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,22">
          <Border Background="#1D3B57" CornerRadius="10" Padding="13,11" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{Binding SessionCaption}" Foreground="White" FontSize="12" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="SessionCaption"/>
              <TextBlock Text="Локальный API · SQLite" Foreground="#8FA8BD" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Button Content="Выйти" Style="{StaticResource NavButton}" Command="{Binding Logout}"
                  AutomationProperties.AutomationId="LogoutButton"/>
        </StackPanel>

        <StackPanel Margin="0,6,0,0">
          <TextBlock Text="РАЗДЕЛЫ" Foreground="#6F8AA2" FontSize="11" Margin="24,0,0,10"/>
          <Button Content="◈  Отправления" Style="{StaticResource NavButton}" Command="{Binding SetTab}"
                  CommandParameter="0" AutomationProperties.AutomationId="NavShipments"/>
          <Button Content="◈  Получатели" Style="{StaticResource NavButton}" Command="{Binding SetTab}"
                  CommandParameter="1" AutomationProperties.AutomationId="NavRecipients"
                  Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}"/>
          <Button Content="◈  Статистика" Style="{StaticResource NavButton}" Command="{Binding SetTab}"
                  CommandParameter="2" AutomationProperties.AutomationId="NavStatistics"/>
          <Button Content="◈  Пользователи" Style="{StaticResource NavButton}" Command="{Binding SetTab}"
                  CommandParameter="3" AutomationProperties.AutomationId="NavUsers"
                  Visibility="{Binding IsAdmin, Converter={StaticResource VisibleWhen}}"/>
          <Border Background="#243E56" CornerRadius="9" Padding="13" Margin="18,26,18,0">
            <StackPanel>
              <TextBlock Text="Маршрут отправления" Foreground="{StaticResource Amber}" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="Создано → Склад → В пути → Доставлено" Foreground="#C7D7E6" FontSize="11"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock Text="Возврат — отдельный завершающий этап" Foreground="#8FA8BD" FontSize="11"
                         TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              Padding="30,20">
        <DockPanel>
          <StackPanel>
            <TextBlock Text="Отправления и маршруты" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Поиск, этапы, курьеры и выгрузки в одном окне" Foreground="{StaticResource Muted}"
                       FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <Border DockPanel.Dock="Right" Background="#EAF0F5" CornerRadius="18" Padding="13,7"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ShipmentCount, StringFormat='В списке: {0}'}" Foreground="{StaticResource Navy}"
                       FontSize="12" AutomationProperties.AutomationId="ShipmentCount"/>
          </Border>
        </DockPanel>
      </Border>

      <TabControl Grid.Row="1" SelectedIndex="{Binding Tab}" Padding="26,20"
                  AutomationProperties.AutomationId="WorkspaceTabs">
        <TabItem>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Реестр отправлений" Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,14"/>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,0,0,12">
              <WrapPanel>
                <TextBox Width="240" Height="36" Margin="0,0,9,0" ToolTip="Номер, получатель, адрес, описание, телефон"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="ShipmentSearchInput" AutomationProperties.Name="Поиск отправлений">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RefreshShipments}"/>
                  </TextBox.InputBindings>
                </TextBox>
                <ComboBox Width="170" Height="36" Margin="0,0,9,0" ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Name"
                          AutomationProperties.AutomationId="StatusFilter" AutomationProperties.Name="Фильтр по этапу"/>
                <Button Content="Обновить" Style="{StaticResource SoftButton}" Height="36" Command="{Binding RefreshShipments}"
                        AutomationProperties.AutomationId="RefreshShipmentsButton" Margin="0,0,9,0"/>
                <Button Content="Новое отправление" Style="{StaticResource PrimaryButton}" Height="36"
                        Command="{Binding NewShipment}" AutomationProperties.AutomationId="NewShipmentButton"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}" Margin="0,0,9,0"/>
                <Button Content="Карточка" Style="{StaticResource SoftButton}" Height="36"
                        Command="{Binding DetailsShipment}" AutomationProperties.AutomationId="DetailsButton" Margin="0,0,9,0"/>
                <Button Content="Изменить" Style="{StaticResource SoftButton}" Height="36"
                        Command="{Binding EditShipment}" AutomationProperties.AutomationId="EditShipmentButton"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}" Margin="0,0,9,0"/>
                <Button Content="Сменить этап" Style="{StaticResource PrimaryButton}" Height="36"
                        Command="{Binding Transition}" AutomationProperties.AutomationId="TransitionButton"/>
              </WrapPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
              <WrapPanel>
                <TextBlock Text="Выгрузка:" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           FontSize="12" Margin="0,0,10,0"/>
                <Button Content="CSV" Style="{StaticResource SoftButton}" Command="{Binding Export}"
                        CommandParameter="csv" AutomationProperties.AutomationId="ExportCsvButton" Margin="0,0,7,0"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}"/>
                <Button Content="JSON" Style="{StaticResource SoftButton}" Command="{Binding Export}"
                        CommandParameter="json" AutomationProperties.AutomationId="ExportJsonButton" Margin="0,0,7,0"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}"/>
                <Button Content="XML" Style="{StaticResource SoftButton}" Command="{Binding Export}"
                        CommandParameter="xml" AutomationProperties.AutomationId="ExportXmlButton"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Text="Курьер видит только закреплённые отправления" Foreground="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"/>
              </WrapPanel>
            </Border>
            <Grid>
              <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                <DataGrid ItemsSource="{Binding Shipments}" SelectedItem="{Binding SelectedShipment}"
                          AutomationProperties.AutomationId="ShipmentsGrid" Margin="1">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding TrackingNumber}" Width="120" MinWidth="105"/>
                    <DataGridTextColumn Header="Получатель" Binding="{Binding Recipient}" Width="1.5*" MinWidth="140"/>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding DeliveryAddress}" Width="1.4*" MinWidth="150"/>
                    <DataGridTextColumn Header="Курьер" Binding="{Binding Courier, TargetNullValue=—}" Width="130" MinWidth="110"/>
                    <DataGridTemplateColumn Header="Этап" Width="155" MinWidth="145">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                  CornerRadius="11" Padding="9,4" HorizontalAlignment="Left" Margin="6,3">
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding DeclaredAmount, StringFormat=N2}"
                                        Width="115" MinWidth="100"/>
                    <DataGridTextColumn Header="Создано" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                        Width="112" MinWidth="100"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
              <TextBlock Text="Нет отправлений по текущему фильтру" Foreground="{StaticResource Muted}"
                         FontSize="15" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding ShipmentCount, Converter={StaticResource EmptyText}}"/>
            </Grid>
          </DockPanel>
        </TabItem>

        <TabItem>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Справочник получателей" Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,14"/>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="13" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Command="{Binding NewRecipient}"
                        AutomationProperties.AutomationId="NewRecipientButton" Margin="0,0,8,0"/>
                <Button Content="Изменить" Style="{StaticResource SoftButton}" Command="{Binding EditRecipient}"
                        AutomationProperties.AutomationId="EditRecipientButton" Margin="0,0,8,0"/>
                <Button Content="Импорт CSV" Style="{StaticResource SoftButton}" Command="{Binding Import}"
                        AutomationProperties.AutomationId="ImportButton" Margin="0,0,8,0"/>
                <Button Content="Обновить" Style="{StaticResource SoftButton}" Command="{Binding RefreshRecipients}"
                        AutomationProperties.AutomationId="RefreshRecipientsButton"/>
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="12"
                       Text="CSV в UTF-8: Name,Phone,Address,Email. Номера ошибочных строк показываются после импорта."
                       Margin="0,10,0,0"/>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
              <DataGrid ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}"
                        AutomationProperties.AutomationId="RecipientsGrid" Margin="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                  <DataGridTextColumn Header="Получатель" Binding="{Binding Name}" Width="1.3*" MinWidth="150"/>
                  <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*" MinWidth="135"/>
                  <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="1.3*" MinWidth="150"/>
                  <DataGridTextColumn Header="Эл. почта" Binding="{Binding Email}" Width="1.2*" MinWidth="150"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </TabItem>

        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <DockPanel Margin="0,0,0,16">
                <TextBlock Text="Статистика доставки" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button Content="Обновить" Style="{StaticResource SoftButton}" DockPanel.Dock="Right"
                        Command="{Binding RefreshStatistics}" AutomationProperties.AutomationId="RefreshStatisticsButton"/>
              </DockPanel>
              <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Padding="16" Margin="0,0,9,0">
                  <StackPanel>
                    <TextBlock Text="Всего отправлений" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Statistics.Total}" FontSize="27" Foreground="{StaticResource Navy}"
                               FontWeight="SemiBold" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Padding="16" Margin="0,0,9,0">
                  <StackPanel>
                    <TextBlock Text="В работе" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Statistics.Active}" FontSize="27" Foreground="{StaticResource AmberDark}"
                               FontWeight="SemiBold" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Padding="16" Margin="0,0,9,0">
                  <StackPanel>
                    <TextBlock Text="Доставлено" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Statistics.Delivered}" FontSize="27" Foreground="{StaticResource Teal}"
                               FontWeight="SemiBold" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Padding="16">
                  <StackPanel>
                    <TextBlock Text="Возвраты" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Statistics.Returned}" FontSize="27" Foreground="#9A6B72"
                               FontWeight="SemiBold" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      Padding="16" Margin="0,0,0,14">
                <WrapPanel>
                  <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Сумма всех отправлений" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding AmountText}" FontSize="17" Foreground="{StaticResource Navy}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Сумма доставленных" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding DeliveredAmountText}" FontSize="17" Foreground="{StaticResource Teal}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Средний срок выполнения" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding AverageDays}" FontSize="17" Foreground="{StaticResource Navy}" Margin="0,5,0,0"/>
                  </StackPanel>
                </WrapPanel>
              </Border>
              <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      Padding="16" HorizontalAlignment="Left" MinWidth="430">
                <StackPanel>
                  <TextBlock Text="Отправления по этапам" Foreground="{StaticResource Navy}" FontWeight="SemiBold"
                             Margin="0,0,0,10"/>
                  <DataGrid ItemsSource="{Binding StatusRows}" AutomationProperties.AutomationId="StatisticsGrid"
                            Width="390" HorizontalAlignment="Left">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Этап" Binding="{Binding Name}" Width="2*"/>
                      <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Пользователи службы" Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,14"/>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="13" Margin="0,0,0,12">
              <Button Content="Обновить" Style="{StaticResource SoftButton}" Command="{Binding RefreshUsers}"
                      AutomationProperties.AutomationId="RefreshUsersButton"/>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
              <DataGrid ItemsSource="{Binding Users}" AutomationProperties.AutomationId="UsersGrid" Margin="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                  <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="*"/>
                  <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </TabItem>
      </TabControl>

      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
              Padding="26,10">
        <DockPanel>
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource AmberDark}" FontSize="13"
                     TextWrapping="Wrap" AutomationProperties.AutomationId="WorkspaceMessage"/>
          <TextBlock Text="F5 — обновление данных · все действия проверяются на сервере"
                     DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
