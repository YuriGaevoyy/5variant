{
  "urls": "https://localhost:7135",
  "ConnectionStrings": {
    "Default": "Data Source=delivery.db"
  },
  "Delivery": {
    "SeedDemo": true
  },
  "Jwt": {
    "Issuer": "DeliveryService",
    "Audience": "DeliveryService.Client",
