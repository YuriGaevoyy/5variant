<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Product>DeliveryService</Product>
    <Version>0.9.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- NU1901/NU1902 are informational transitively vulnerable package notices for test tooling;
         the packages used here are pinned and audited in docs/security.md. -->
    <NoWarn>$(NoWarn);NU1901;NU1902</NoWarn>
  </PropertyGroup>
</Project>
